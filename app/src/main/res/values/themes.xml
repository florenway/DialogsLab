<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DialogsLab" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/red_frame</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DialogsLab.Alert</item>
    </style>

    <style name="ThemeOverlay.DialogsLab.Alert" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/blue</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DialogsLab.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DialogsLab.DialogButton</item>
    </style>

    <style name="Widget.DialogsLab.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.DialogsLab.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
